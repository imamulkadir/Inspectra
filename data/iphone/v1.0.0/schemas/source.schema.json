{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "type": "object",
  "required": [
    "id",
    "publisher",
    "title",
    "url",
    "sourceType",
    "verifiedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "sourceType": {
      "type": "string"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date"
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
