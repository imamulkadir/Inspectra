{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settings-path.schema.json",
  "type": "object",
  "required": [
    "id",
    "concept",
    "routes",
    "sourceIds"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "concept": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "steps"
        ],
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
