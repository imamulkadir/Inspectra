{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inspection-rule.schema.json",
  "type": "object",
  "required": [
    "id",
    "categoryId",
    "title",
    "question",
    "method",
    "priority",
    "answerSetId",
    "applicability",
    "scoring",
    "risk"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "categoryId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "answerSetId": {
      "type": "string"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
